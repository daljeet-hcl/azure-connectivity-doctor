# Selects the test runner used by `dotnet test`.
#
# xunit.v3 is built on Microsoft.Testing.Platform (MTP). The .NET 10 SDK removed the VSTest
# bridge that previously allowed MTP test projects to be driven through `dotnet test`, so the
# runner must be chosen explicitly here. Without this file the build fails with:
#   "Testing with VSTest target is no longer supported by Microsoft.Testing.Platform
#    on .NET 10 SDK and later."
#
# See https://learn.microsoft.com/dotnet/core/testing/unit-testing-with-dotnet-test
[dotnet.test.runner]
name = "Microsoft.Testing.Platform"
