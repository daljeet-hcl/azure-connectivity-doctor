<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AzureConnectivityDoctor.IntegrationTests</RootNamespace>
    <AssemblyName>AzureConnectivityDoctor.IntegrationTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- See the unit-test project: the MTP runner is selected in global.json. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AzureConnectivityDoctor.Core\AzureConnectivityDoctor.Core.csproj" />
  </ItemGroup>

</Project>
