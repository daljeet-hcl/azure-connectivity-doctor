# EditorConfig for Azure Connectivity Doctor.
# `dotnet format` in CI enforces the whitespace and using-directive rules below.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{csproj,props,targets,slnx,config,xml}]
indent_size = 2

[*.cs]
indent_size = 4

# using directives outside the namespace, System first.
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# File-scoped namespaces keep the whole file at one indentation level.
csharp_style_namespace_declarations = file_scoped:warning

# Braces are always required, even for single statements.
csharp_prefer_braces = true:warning

# Language style preferences.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_readonly_field = true:suggestion
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_prefer_primary_constructors = false:suggestion

# New line preferences (these are what `dotnet format whitespace` enforces).
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_between_query_expression_clauses = true

# Indentation preferences.
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_indent_block_contents = true
csharp_indent_braces = false

# Space preferences.
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after

# Wrapping.
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

#
# Analyzer rules that are deliberately disabled for this project.
# Each entry states WHY, so a future maintainer can re-evaluate it rather than guess.
#

# CA1031: "Do not catch general exception types".
# A diagnostic tool must survive *any* failure of the thing it is probing and turn it
# into an evidence record. Broad catches around probe bodies are the intended design.
dotnet_diagnostic.CA1031.severity = none

# CA1848: "Use LoggerMessage delegates". Source-generated log delegates are a hot-path
# optimisation. This tool emits tens of log lines per run, so the readability of plain
# ILogger calls is worth more than the allocation savings.
dotnet_diagnostic.CA1848.severity = none

# CA1873: "Evaluation of this argument may be expensive if logging is disabled". Same
# reasoning as CA1848: the arguments here are host names and enum values, and the run
# emits tens of log lines, not millions.
dotnet_diagnostic.CA1873.severity = none

# CA1303: "Do not pass literals as localized parameters". The tool is English-only by
# design; a resource-file indirection would obscure the diagnostic text.
dotnet_diagnostic.CA1303.severity = none

# CA1812: "Avoid uninstantiated internal classes". Types are instantiated by the
# dependency-injection container, which the analyzer cannot see.
dotnet_diagnostic.CA1812.severity = none

# CA2007: "Consider calling ConfigureAwait". There is no synchronization context in a
# console host, so ConfigureAwait(false) everywhere would be noise without effect.
dotnet_diagnostic.CA2007.severity = none

# CA1054/CA1056: "URI parameters should not be strings". Endpoints arrive from the
# command line as raw strings and may be malformed; parsing them is the tool's job.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none

# CA1062: "Validate arguments of public methods". Nullable reference types are enabled
# and enforced, which covers this statically.
dotnet_diagnostic.CA1062.severity = none

# CA1014: "Mark assemblies with CLSCompliant". The library is consumed only by this
# tool's own C# projects; declaring CLS compliance would imply a cross-language support
# commitment that is not offered.
dotnet_diagnostic.CA1014.severity = none

# CA1859: "Change type for improved performance". Interface-typed parameters are used
# deliberately so that call sites cannot mutate the collections they pass in.
dotnet_diagnostic.CA1859.severity = none

[src/AzureConnectivityDoctor.Core/Probes/TlsProbe.cs]
# CA5359: "Do not disable certificate validation".
# This is intentional and is the entire point of the TLS probe: the callback returns true so
# that the handshake completes far enough to capture the certificate chain and the exact
# SslPolicyErrors value, which are then reported as the real validation outcome. The stream is
# closed immediately; no application data is ever read from it or written to it, so an
# untrusted certificate can never be acted upon. See docs/adr/0004-tls-probe-certificate-capture.md.
dotnet_diagnostic.CA5359.severity = none

[tests/**/*.cs]
# CA1707: underscores in test method names are the established readability convention.
dotnet_diagnostic.CA1707.severity = none
# CA1515: test classes must be public for the runner to discover them.
dotnet_diagnostic.CA1515.severity = none
