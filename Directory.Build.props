<Project>

  <!--
    Repository-wide MSBuild settings.

    For readers coming from Java or Python: this file plays roughly the same role as the
    <properties> section of a Maven parent POM, or the [tool] tables of pyproject.toml.
    Every project (.csproj) below this directory inherits these values automatically.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Compiler warnings are errors: no silently ignored problems reach main. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!--
      Static analysis runs, but analyzer suggestions do not fail the build. Compiler
      correctness warnings (CS????) still do, via TreatWarningsAsErrors above.
      See docs/adr/0006-analyzer-and-formatting-policy.md for the rationale.
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>

    <!-- Reproducible / deterministic build settings. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet lock files pin the entire transitive dependency graph. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Supply-chain hardening. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <Product>Azure Connectivity Doctor</Product>
    <Company>Azure Connectivity Doctor contributors</Company>
    <Authors>Azure Connectivity Doctor contributors</Authors>
    <Copyright>Copyright (c) Azure Connectivity Doctor contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/daljeet-hcl/azure-connectivity-doctor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/daljeet-hcl/azure-connectivity-doctor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>

</Project>
