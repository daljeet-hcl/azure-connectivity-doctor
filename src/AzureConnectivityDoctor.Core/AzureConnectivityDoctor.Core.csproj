<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AzureConnectivityDoctor.Core</RootNamespace>
    <AssemblyName>AzureConnectivityDoctor.Core</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- CS1591 (missing XML comment) is not enforced on internal helper members. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Azure.ResourceManager" />
    <PackageReference Include="Azure.ResourceManager.Resources" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AzureConnectivityDoctor.Core.Tests" />
    <InternalsVisibleTo Include="AzureConnectivityDoctor.IntegrationTests" />
  </ItemGroup>

</Project>
