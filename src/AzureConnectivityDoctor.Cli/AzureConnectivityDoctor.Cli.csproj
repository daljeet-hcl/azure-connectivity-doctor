<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AzureConnectivityDoctor.Cli</RootNamespace>
    <AssemblyName>azure-connectivity-doctor</AssemblyName>

    <!-- Packaged as a .NET global tool: dotnet tool install -g AzureConnectivityDoctor -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>AzureConnectivityDoctor</PackageId>
    <ToolCommandName>azure-connectivity-doctor</ToolCommandName>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\package</PackageOutputPath>

    <!-- The tool formats every number and date with the invariant culture, so the ICU data is
         not needed. Disabling it keeps self-contained publishes substantially smaller. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Reflection-based System.Text.Json serialisation is used for the report, so trimming and
         native AOT are deliberately not enabled. See docs/adr/0005-publish-model.md. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>

    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzureConnectivityDoctor.Core\AzureConnectivityDoctor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AzureConnectivityDoctor.Core.Tests" />
  </ItemGroup>

</Project>
